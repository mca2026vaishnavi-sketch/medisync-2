<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#111F30">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Medical Reports"
        android:textColor="#E6F7FF"
        android:textSize="25sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View and manage your saved medical reports."
        android:textColor="#9AB4C5"
        android:textSize="14sp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnAddReport"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="+ Add Report"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#35F2D0"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvEmptyReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No medical reports saved yet."
        android:textColor="#9AB4C5"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvMedicalReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#244456"
        android:dividerHeight="1dp"
        android:background="#111F30" />

</LinearLayout>